{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "env": {
    "NEXT_PUBLIC_API_URL": "https://sabrinas-town.vercel.app/api"
  },
  "builds": [
    {
      "src": "sites/hife/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "api/index.ts",
      "use": "@vercel/node@3"
    }
  ],
  "routes": [
    { "src": "/api/cron/(.*)", "dest": "/sites/hife/api/cron/$1" },
    { "src": "/api/(.*)", "dest": "/api/index.ts" },
    { "src": "/(.*)", "dest": "/sites/hife/$1" }
  ],
  "crons": [
    { "path": "/api/cron/content-refresh", "schedule": "0 6 * * *" },
    { "path": "/api/cron/enrich-images", "schedule": "0 3 * * 2" },
    { "path": "/api/cron/email-digest", "schedule": "0 12 * * 1" },
    { "path": "/api/cron/event-ingestion", "schedule": "0 7 * * *" }
  ]
}
