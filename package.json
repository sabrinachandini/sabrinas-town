{
  "name": "sabrinas-town",
  "version": "1.0.0",
  "description": "History Is For Everyone — monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:hife": "turbo dev --filter=hife",
    "build": "turbo build",
    "build:hife": "turbo build --filter=hife",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/seed/index.ts",
    "db:reset": "prisma migrate reset --force",
    "api:dev": "tsx watch src/server.ts",
    "api:build": "prisma generate && tsc",
    "vercel-build": "npx prisma generate || true",
    "lint:links": "npx tsx sites/hife/scripts/validateExternalLinks.ts",
    "create-town": "tsx scripts/create-town.ts"
  },
  "keywords": ["american-revolution", "tourism", "history", "education"],
  "author": "Sabrina Bhattacharjya",
  "license": "MIT",
  "engines": {
    "node": "22.x",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@fastify/cors": "^9.0.1",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.40.0",
    "dotenv": "^16.4.1",
    "fastify": "^4.26.0",
    "nanoid": "^5.0.5",
    "pino-pretty": "^13.1.3",
    "resend": "^6.9.3",
    "stripe": "^20.4.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prisma": "^5.22.0",
    "turbo": "^2.5.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
